# NASA FIRMS map key for the upstream data archive.
FIRMS_MAP_KEY=your_32_char_nasa_firms_map_key_here

# ---------------------------------------------------------------------------
# Dual-System LLM endpoint profiles (ADR-0006).
#
# The harness reads these from the process environment first, then from this
# file, then from apps/ai-service/config/harness_config.yaml. It never reads
# the host's agent tooling configuration.
#
# SYSTEM1_* bind the System 1 Reflexive Layer to a typed-questions endpoint.
# SYSTEM2_* bind the System 2 Deliberative Layer to a native chat endpoint.
# ---------------------------------------------------------------------------
SYSTEM1_API_KEY=
SYSTEM2_API_KEY=

# Optional overrides. Leave empty to use the harness config defaults.
SYSTEM1_ENDPOINT=
SYSTEM1_MODEL=
SYSTEM2_ENDPOINT=
SYSTEM2_MODEL=
