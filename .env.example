# NASA FIRMS map key for the upstream data archive.
FIRMS_MAP_KEY=your_32_char_nasa_firms_map_key_here

# ---------------------------------------------------------------------------
# Dual-System LLM endpoint profiles (ADR-0006).
#
# The harness reads these from the process environment first, then from this
# file, then from apps/ai-service/config/harness_config.yaml. It never reads
# the host's agent tooling configuration.
#
# SYSTEM1_* bind the System 1 Reflexive Layer to a decision endpoint that
# answers typed questions with calibrated probabilities. The endpoint is
# normally the project's own inference node, reached over a tunnel:
#   ssh -f -N -L 11434:<decision-node>:11434 <alias>
# SYSTEM1_FALLBACK_* bind the chat endpoint that answers when the decision
# endpoint cannot be reached; the chain then ends at the deterministic text
# extraction, so a run never fails for lack of a model.
# SYSTEM2_* bind the System 2 Deliberative Layer to a native chat endpoint.
# ---------------------------------------------------------------------------
SYSTEM1_API_KEY=
SYSTEM2_API_KEY=

# Optional overrides. Leave empty to use the harness config defaults.
SYSTEM1_ENDPOINT=
SYSTEM1_MODEL=
SYSTEM1_FALLBACK_ENDPOINT=
SYSTEM1_FALLBACK_MODEL=
SYSTEM2_ENDPOINT=
SYSTEM2_MODEL=
