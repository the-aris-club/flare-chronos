{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": [
    "node_modules",
    "src/i18n/messages.test.ts",
    "src/lib/workbench/format.test.ts",
    "src/data/fixtures/review-facts.test.ts",
    "src/lib/review/decisions-route.test.ts",
    "src/lib/review/submit-decision.test.ts",
    "src/lib/workbench/regions.test.ts",
    "src/lib/workbench/series.test.ts",
    "src/lib/workbench/tour-figures.test.ts",
    "src/lib/workbench/query-box.test.ts"
  ]
}
