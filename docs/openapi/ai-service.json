          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "text/event-stream": {}
            },
            "description": "Server-Sent Events"
          },
          "401": {
            "description": "missing or invalid bearer token"
          },
          "403": {
            "description": "only the owner or an approver may decide"
          },
          "404": {
            "description": "no such run"
          },
          "409": {
            "description": "the run has no sign-off request waiting"
