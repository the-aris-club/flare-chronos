      }
    },
    "viewModel": {
      "region": "mekong | amazon",
      "years": "number[]",
      "cells": "CalendarCell[y][p]",
      "maxHfd": "number",
      "scoredPentad": "number",
      "observedYears": "number[]",
      "cell": {
        "year": "number",
        "pentad": "number (1..73)",
        "hfd": "number",
        "sfai": "number | null",
        "provenance": "observed | modelled",
        "alert": "observed and sfai >= 2.2",
        "crisis": "observed and sfai >= 2.5"
      },
      "unit": "density | detections"
    },
    "parityFixture": {
      "path": "docs/design/fixtures/design-calendar.json",
      "enabledBy": "CALENDAR_FIXTURE=design",
      "shape": "design getData('mekong') output, 2000–2025, hfd/z/obs keyed by year",
      "rule": "Parity only. Never a production data source."
    },
    "fillRules": {
      "hfd": "t = sqrt(hfd / maxHfd); sequential oklch ramp",
      "sfai": "clamp(|z|, 0, 3) / 3; diverging oklch ramp, negative hue 255, positive hue 35",
      "observed": "provenance 0 or 1",
      "modelled": "provenance 2 — dot pattern overlay",
      "alert": "observed and sfai >= 2.2 — 1.5px cyan ring",
      "crisis": "observed and sfai >= 2.5 — cyan corner flag plus ring",
      "notScored": "sfai null and observed — raised cell, never zero"
    },
    "map": {
      "path": "apps/workbench/src/data/map-data.json",
      "generatedBy": "apps/workbench/scripts/flag-map-points.py → apps/workbench/scripts/build-map-data.mjs",
      "source": "data/raw/*.csv (NASA FIRMS) flagged by the harmonization core; world-atlas countries-110m",
      "points": "x/y/sensor + flag bitmask: SZA night (1), SAA false alarm (2), static source (4), 60-min duplicate (8)",
      "counts": "Per epoch raw, SZA, SAA, static and duplicate counts from the full slices",
      "h3": "Runtime screen-space H3 bins at Res 4–8 derived from the projected real points; no synthetic cells",
      "rule": "Pre-projected SVG paths and sampled real points. No synthetic points in production."
    },
    "series": {
      "path": "data/processed/empirical_results.json",
      "fields": {
        "regime_shift_series": "annual raw counts and MODIS-equivalent counts, 2001–2026",
        "mekong_empirical_epochs": "measured epoch dates, raw detections, episodes, SAA/SZA counts",
        "amazon_empirical_epochs": "same, Amazon",
        "scan_angle_physics": "MODIS/VIIRS footprint areas and ratio"
