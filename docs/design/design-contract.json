      ],
      "fields": {
        "years": "number[26] — 2001–2026",
        "hfd_matrix": "number[26][73] — Harmonized Fire Density, events/100 km²/day",
        "sfai_matrix": "(number|null)[26][73] — 10 non-null, all pentad 15",
        "cell_provenance_matrix": "0|1 observed, 2 modelled — 26 × 73",
        "observed_pentad": "number — 15",
        "measured_years": "number[11]",
